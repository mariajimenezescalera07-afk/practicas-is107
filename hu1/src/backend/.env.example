# Copia este archivo a .env y rellénalo
FIREBASE_CREDENTIALS=serviceAccountKey.json
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# Config pública de la app web (Consola Firebase > Configuración del proyecto > Tus apps)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

DOMINIOS_UCO=uco.es,red.uco.es
CORS_ORIGINS=http://localhost:5000
LOGIN_URL=/login.html
REDIRECT_DELAY_MS=5000

# Solo para seed.py
ADMIN_EMAIL=admin@uco.es
ADMIN_PASSWORD=cambia-esto-ya-12345
